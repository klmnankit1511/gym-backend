# SQL Server / Azure SQL Database
# Percent-encode reserved characters in usernames/passwords (for example, @ is %40).
# Local Docker: mssql+pymssql://sa:password@db:1433/gym_db
# Azure SQL: mssql+pymssql://username:password@server.database.windows.net:1433/database_name
DATABASE_URL=mssql+pymssql://sa:GymAdmin%40123%21@localhost:1433/gym_db

# Cosmos DB (Azure Cosmos or local emulator)
# Local Emulator: https://localhost:8081/
# Well-known emulator key: C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4AR0dM8s4fVOMg4aiKPAwGBA+ES-x+IB3jMEVsByKYo1F+mAGDA==
# Azure: https://{account-name}.documents.azure.com:443/
COSMOS_ENDPOINT=https://localhost:8081/
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4AR0dM8s4fVOMg4aiKPAwGBA+ES-x+IB3jMEVsByKYo1F+mAGDA==
COSMOS_DATABASE=gym_audit

# CORS Origins
CORS_ORIGINS=["http://localhost:3000"]

# JWT / Auth
SECRET_KEY=dev-secret-key-change-in-production-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_VERSION=v1
